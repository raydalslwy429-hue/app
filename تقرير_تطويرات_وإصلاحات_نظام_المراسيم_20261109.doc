      background: #ffffff;
      margin: 0;
      padding: 0;
    }
    .header-banner {
      background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
      color: #ffffff;
      padding: 28px 24px;
      border-radius: 12px;
      margin-bottom: 25px;
      border-bottom: 4px solid #8b7355;
    }
    .brand-title {
      font-size: 26pt;
      font-weight: 900;
      color: #d4af37;
      margin: 0 0 6px 0;
    }
    .sub-title {
      font-size: 14pt;
      color: #e2e8f0;
      margin: 0;
    }
    .meta-box {
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      padding: 16px;
      margin-bottom: 25px;
    }
    .meta-table {
      width: 100%;
      border-collapse: collapse;
    }
    .meta-table td {
      padding: 8px 12px;
